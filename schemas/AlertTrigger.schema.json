{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vulnetix/config-schemas/releases/download/v0.0.0-dev/AlertTrigger.schema.json",
  "title": "AlertTrigger",
  "description": "A Guardian trigger: run a SavedSearch or a DetectionRule on a schedule and, when its rows pass the levers, start a Software Factory workflow, post to messaging connections or send an email, with the rows as context. No rows, nothing starts. Name exactly one of searchRef or ruleRef. The plan caps how many triggers are enabled at once.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "AlertTrigger" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": {
      "type": "object",
      "required": ["destination"],
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "description": "The name the console shows. Defaults to metadata.name.",
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "searchRef": {
          "description": "The metadata.name of the SavedSearch to run.",
          "$ref": "common.schema.json#/$defs/name"
        },
        "ruleRef": {
          "description": "The metadata.name of the DetectionRule to run.",
          "$ref": "common.schema.json#/$defs/name"
        },
        "everySec": {
          "description": "Seconds between runs.",
          "type": "integer",
          "minimum": 60,
          "maximum": 86400,
          "default": 300
        },
        "enabled": { "type": "boolean", "default": true },
        "levers": {
          "description": "When a run fires, and what it sends.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minRows": {
              "description": "Fire when a group has at least this many rows in the window.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100000,
              "default": 1
            },
            "windowSec": {
              "description": "How far back each run looks, in seconds.",
              "type": "integer",
              "minimum": 60,
              "maximum": 604800,
              "default": 300
            },
            "countBy": {
              "description": "Count rows per this column. Left out, the whole result is one group.",
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]{0,62}$"
            },
            "cooldownSec": {
              "description": "Do not fire the same group again for this long, in seconds.",
              "type": "integer",
              "minimum": 0,
              "maximum": 604800,
              "default": 3600
            },
            "maxPerHour": {
              "description": "At most this many fires per hour for the trigger.",
              "type": "integer",
              "minimum": 1,
              "maximum": 60,
              "default": 4
            },
            "hours": {
              "description": "When it may fire. business is 09:00 to 17:00, Monday to Friday, in zone.",
              "type": "string",
              "enum": ["always", "business", "outside_business"],
              "default": "always"
            },
            "zone": {
              "description": "The IANA time zone for hours.",
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "default": "UTC"
            },
            "rowsCap": {
              "description": "Rows sent as context, at most.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "columns": {
              "description": "Columns sent. Left out, every column of the result.",
              "type": "array",
              "maxItems": 30,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" }
            },
            "ask": {
              "description": "For workflow runs: workflow follows the workflow's asks; always asks a person before any change.",
              "type": "string",
              "enum": ["workflow", "always"],
              "default": "workflow"
            }
          }
        },
        "destination": {
          "description": "What a fire starts. workflow: a siem.fired source event for the Software Factory, which every published workflow whose trigger matches it takes. messaging: a post to each connection. email: a message to each address.",
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": { "type": "string", "enum": ["workflow", "messaging", "email"] },
            "connections": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/messagingConnectionRef" }
            },
            "emails": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true,
              "items": { "type": "string", "format": "email", "maxLength": 254 }
            },
            "severity": {
              "type": "string",
              "enum": ["info", "notice", "warning", "critical"],
              "default": "warning"
            }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "messaging" } } },
              "then": { "required": ["connections"], "properties": { "emails": false } }
            },
            {
              "if": { "properties": { "kind": { "const": "email" } } },
              "then": { "required": ["emails"], "properties": { "connections": false } }
            },
            {
              "if": { "properties": { "kind": { "const": "workflow" } } },
              "then": { "properties": { "connections": false, "emails": false } }
            }
          ]
        }
      },
      "oneOf": [{ "required": ["searchRef"] }, { "required": ["ruleRef"] }]
    }
  }
}
